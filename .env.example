# ---- Public (exposed to the browser) ---------------------------------------
# Canonical site URL (used for metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp number in international digits only, e.g. 15551234567.
# When empty, the floating button scrolls to the contact form instead.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---- Server only (never prefix with NEXT_PUBLIC_) --------------------------
# Inquiry email via Resend. If any of the three is missing the API runs in DEMO
# mode: submissions are validated and acknowledged but nothing is sent.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=
INQUIRY_TO_EMAIL=

# ---- Optional tuning --------------------------------------------------------
# Max inquiry submissions per IP per 10 minutes (default 5). Raise for automated tests only.
INQUIRY_RATE_LIMIT=5
